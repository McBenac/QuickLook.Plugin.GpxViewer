<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>QuickLook.Plugin.GpxViewer</RootNamespace>
    <AssemblyName>QuickLook.Plugin.GpxViewer</AssemblyName>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <Version>1.0.0</Version>
    <Product>QuickLook.Plugin.GpxViewer</Product>
    <Description>Previews GPX tracks, routes and waypoints on a map.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same WebView2 SDK version as QuickLook's own HtmlViewer, so both plugins load identical assemblies. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- QuickLook loads its own QuickLook.Common.dll; never ship a second copy. -->
    <ProjectReference Include="..\QuickLook.Common\QuickLook.Common.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="QuickLook.Plugin.Metadata.config" CopyToOutputDirectory="Always" />
    <None Include="..\viewer\**\*" LinkBase="viewer" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GpxViewer.Harness" />
  </ItemGroup>

</Project>
